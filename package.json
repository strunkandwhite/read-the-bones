{
  "name": "read-the-bones",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prepare": "husky",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"scripts/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "precommit": "pnpm typecheck && pnpm lint && pnpm knip && pnpm test && pnpm test:e2e",
    "test": "vitest run",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:watch": "vitest",
    "screenshot": "npx tsx scripts/screenshot.ts",
    "sync": "tsx scripts/sync.ts",
    "draft:create": "tsx scripts/draft-create.ts",
    "draft:reset": "tsx scripts/draft-reset.ts",
    "draft:delete": "tsx scripts/draft-delete.ts",
    "decklists": "tsx scripts/decklists.ts",
    "db:migrate": "tsx src/core/db/migrate.ts",
    "draft:create-live": "tsx scripts/draft-create-live.ts",
    "draft:start": "tsx scripts/draft-start.ts",
    "draft:admin": "tsx scripts/draft-admin.ts",
    "scryfall:backfill": "tsx scripts/backfill-scryfall.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@libsql/client": "^0.17.4",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.9",
    "@vercel/analytics": "^2.0.1",
    "dotenv": "^17.4.2",
    "google-spreadsheet": "^5.3.0",
    "next": "16.2.12",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "knip": "^6.29.0",
    "memfs": "^4.64.0",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
